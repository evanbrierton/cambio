{
  "name": "cambio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:lan": "bash scripts/dev-lan.sh",
    "party:dev": "wrangler dev --ip 0.0.0.0 --port 8787",
    "party:deploy": "wrangler deploy",
    "party:check": "wrangler deploy --dry-run",
    "build": "next build",
    "vercel-build": "bash scripts/vercel-build.sh",
    "start": "next start",
    "lint": "biome check --error-on-warnings && node scripts/tailwind-lint.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "biome format --write",
    "ci": "pnpm lint && pnpm typecheck && pnpm test && pnpm party:check && pnpm build"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "framer-motion": "^12.43.0",
    "nanoid": "^6.0.1",
    "next": "16.3.0",
    "partyserver": "^0.5.10",
    "partysocket": "^1.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@cloudflare/workers-types": "5.20260801.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "tailwind-lint": "0.12.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  }
}
