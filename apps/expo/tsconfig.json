{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@cambio/web-lib/*": [
        "../../src/lib/*"
      ],
      "@/game/*": [
        "../../packages/game/src/*"
      ],
      "@/lib/*": [
        "../../src/lib/*"
      ],
      "@cambio/game": [
        "../../packages/game/src/index.ts"
      ],
      "@cambio/game/*": [
        "../../packages/game/src/*"
      ],
      "@cambio/client": [
        "../../packages/client/src/index.ts"
      ],
      "@cambio/client/*": [
        "../../packages/client/src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ],
  "exclude": [
    "node_modules"
  ],
  "extends": "expo/tsconfig.base"
}
