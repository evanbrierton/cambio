{
  "name": "@cambio/native",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "cap:doctor": "cap doctor",
    "cap:sync": "cap sync && cap ls",
    "cap:ls": "cap ls",
    "cap:copy": "cap copy",
    "cap:add:ios": "cap add ios",
    "cap:add:android": "cap add android",
    "cap:open:ios": "cap open ios",
    "cap:open:android": "cap open android",
    "assets:generate": "node scripts/generate-resources.mjs",
    "assets:sync": "pnpm assets:generate && cap-assets generate --assetPath resources --iconBackgroundColor '#12061f' --iconBackgroundColorDark '#12061f' --splashBackgroundColor '#12061f' --splashBackgroundColorDark '#12061f'"
  },
  "dependencies": {
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/share": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "sharp": "^0.35.3"
  }
}
