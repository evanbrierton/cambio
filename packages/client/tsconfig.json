{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "paths": {
      "@cambio/game": ["../game/src/index.ts"],
      "@cambio/game/*": ["../game/src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
